# Database connection string (PostgreSQL 16 required; citext extension enabled by migration).
#
# IMPORTANT — password encoding: if your DB password contains `/`, `@`, `:`, or `%`
# (Railway's generated passwords can), percent-encode it in this URL or `pg` will
# misparse the connection string and connect will fail with a cryptic error.
#   `/` -> `%2F`   `@` -> `%40`   `:` -> `%3A`   `%` -> `%25`
# `apps/web/src/lib/env.ts` fails fast with this hint in production; in dev it warns.
DATABASE_URL=postgres://learning_platform:learning_platform@localhost:5432/learning_platform

# Auth.js secret — minimum 32 bytes. Generate with: openssl rand -base64 32
# NEVER commit a real secret to version control.
AUTH_SECRET=replace-me-in-production-32-bytes-minimum

# Required when behind a reverse proxy (Nginx, Caddy, etc.)
AUTH_TRUST_HOST=true

# NextAuth base URL (must match the canonical URL of the app)
NEXTAUTH_URL=http://localhost:3000

# ── Password-reset SMS (verification codes) ───────────────────────────
# "mock" (default): logs the code to the server console and echoes it back
#   in non-production API responses — no gateway needed for local testing.
# "kavenegar": sends a real SMS through https://kavenegar.com
#
# To enable Kaveh Negar on a fresh account:
#   1. Log in at kavenegar.com → «API Key» (کلید API) and copy the key.
#   2. Add credit (شارژ) to the account — real sends consume it.
#   3. Set SMS_PROVIDER=kavenegar and paste the key into KAVENEGAR_API_KEY.
#   4. KAVENEGAR_SENDER is OPTIONAL: when omitted, Kaveh Negar sends from
#      the account's default line (خدمات پیام کوتاه). Set it only if you
#      have claimed a dedicated sender line.
#   5. Smoke-test the whole pipeline with:
#        pnpm sms:test --phone 09123456789
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ── Object storage (course media — ADR-0010) ─────────────────────────
# S3-compatible provider (MinIO in dev/prod via docker-compose). Lesson
# content (video/audio/pdf/text) lives here; the app only ever hands out
# short-lived signed URLs after an enrollment check — so links cannot be
# saved or shared. Leave EMPTY to disable media delivery (lessons render
# their placeholder).
#
# Local dev (docker compose up -d brings up MinIO on :9000):
#   S3_ENDPOINT=http://127.0.0.1:9000
#   S3_ACCESS_KEY=minioadmin
#   S3_SECRET_KEY=minioadmin
#   S3_BUCKET=learning-platform
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=learning-platform
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# ── Mobile install banner (shown to phone-browser visitors) ───────────
# Fill these after publishing to Cafe Bazaar / hosting the APK; when empty
# the corresponding button is hidden (the in-browser install button still
# works whenever the PWA is installable).
#   CAFE_BAZAAR_URL=https://cafebazaar.ir/app/ir.rooyesh.mobile?l=fa
#   APK_DIRECT_URL=https://your-domain.com/app/rooyesh.apk
CAFE_BAZAAR_URL=
APK_DIRECT_URL=
