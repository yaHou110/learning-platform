{
  "name": "hawza-learning-platform",
  "version": "1.1.0",
  "private": true,
  "description": "Hawza Family Learning Platform — AI-native, self-hosted, multi-tenant LMS for Hawza (Islamic seminary) families.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "governance:validate": "node scripts/governance/validate.mjs",
    "governance:validate:local": "node scripts/governance/validate-local.mjs",
    "sync:agents": "node scripts/sync-agents.mjs",
    "db:generate": "pnpm --filter @hawza/core db:generate",
    "db:migrate": "pnpm --filter @hawza/core db:migrate",
    "db:seed:dev": "pnpm --filter @hawza/core db:seed:dev",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml,yml}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
