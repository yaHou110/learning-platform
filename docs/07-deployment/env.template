# /etc/learning-platform/env — production environment template (keys only, no secrets)
#
# Copy to /etc/learning-platform/env on the VPS and fill in real values generated
# per docs/07-deployment/DEPLOYMENT_GUIDE.md §3 step 5a. This file contains NO
# secrets — only the keys and the stable defaults — so it is safe to commit.
# Real secrets live only in the gitignored root .env (locally) and on the host.
#
# chmod 600 /etc/learning-platform/env ; owner root:deploy
#
# See: docs/07-deployment/DEPLOYMENT_GUIDE.md
#      docs/06-sprints/SPRINT-001-production-foundation/evidence/M7-readiness/pre-provision-checklist.md

# Database --------------------------------------------------------------------------
POSTGRES_USER=learning_platform
POSTGRES_DB=learning_platform
POSTGRES_PASSWORD=<generate: openssl rand -base64 48 | tr -d '\n' | head -c 64>

# Auth -----------------------------------------------------------------------------
AUTH_SECRET=<generate: openssl rand -base64 32>
NEXTAUTH_URL=https://<your-domain>   # real public URL; set after DNS (F0.1/F1.2)

# Object storage (MinIO) -----------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<generate: openssl rand -base64 48 | tr -d '\n' | head -c 64>
S3_BUCKET=learning-platform

# Metrics (optional; if unset, /api/metrics returns 503 in prod) -------------------
METRICS_TOKEN=<generate: openssl rand -hex 16>   # 32 hex chars = 128-bit

# Backup ---------------------------------------------------------------------------
BACKUP_DEST=/var/backups/learning-platform
