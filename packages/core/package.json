{
  "name": "@learning-platform/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./auth": "./src/auth/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./api": "./src/api/index.ts"
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "db:seed:dev": "tsx --tsconfig tsconfig.scripts.json scripts/seed-dev.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.0",
    "next-auth": "5.0.0-beta.31",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.0"
  }
}
