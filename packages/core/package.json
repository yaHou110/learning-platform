{
  "name": "@hawza/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./db": "./dist/db/index.js",
    "./db/schema": "./dist/db/schema/index.js",
    "./auth": "./dist/auth/index.js",
    "./plugins": "./dist/plugins/index.js",
    "./api": "./dist/api/index.js"
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.scripts.json scripts/migrate.ts",
    "db:seed:dev": "tsx --tsconfig tsconfig.scripts.json scripts/seed-dev.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.2",
    "bcrypt": "^5.1.1",
    "drizzle-orm": "^0.36.0",
    "next-auth": "5.0.0-beta.25",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.0"
  }
}
