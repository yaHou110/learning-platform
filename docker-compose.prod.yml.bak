# Production Docker Compose
#
# v1 (ADR-0007): single VPS (~4 GB RAM), self-hosted, one dedicated deployment.
# Runs: app (Next.js standalone) + postgres + minio (S3-compatible object storage)
# Nginx reverse proxy runs on the HOST (systemd), not in compose, to terminate TLS
# and do HSTS / rate-limit / metrics internal gating before traffic reaches the app.
#
# Start: `docker compose -f docker-compose.prod.yml up -d`
# Stop:  `docker compose -f docker-compose.prod.yml down`
# Logs:  `docker compose -f docker-compose.prod.yml logs -f`

services:
  postgres:
    image: postgres:16-alpine
    container_name: lp-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-learning_platform}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB:-learning_platform}
    volumes:
      - lp_pg_data:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-learning_platform} -d ${POSTGRES_DB:-learning_platform}"]
      interval: 10s
      timeout: 5s
      retries: 5

  minio:
    # Pin a current MinIO RELEASE. The previously pinned tag
    # (RELEASE.2024-07-19T21-05-03Z) was pruned from Docker Hub and resolves to
    # "not found" on any fresh host/CI run, breaking the prod stack. Bump to a
    # stable current release; re-pin when rotating. Verified present 2026-07-21.
    image: minio/minio:RELEASE.2025-07-23T15-54-02Z
    container_name: lp-minio
    restart: unless-stopped
    command: server /data --console-address ":9001"
    environment:
      MINIO_ROOT_USER: ${MINIO_ROOT_USER:-minioadmin}
      MINIO_ROOT_PASSWORD: ${MINIO_ROOT_PASSWORD}
    volumes:
      - lp_minio_data:/data
    ports:
      - "127.0.0.1:9000:9000"
      - "127.0.0.1:9001:9001"
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 10s
      timeout: 5s
      retries: 5

  # One-shot schema migration runner (ADR-0017). Builds the `migrate` Dockerfile
  # target (reuses the builder stage so it has tsx + drizzle-orm + pg + the source)
  # and runs the real Drizzle `migrate()` against the prod DATABASE_URL, then
  # exits 0. Idempotent (Drizzle's `__drizzle_migrations` table). The `app`
  # service depends_on this with `service_completed_successfully`, so the app
  # NEVER boots into a schema-less DB — fixing the M7-prep gap that made
  # /api/health return `degraded (db:false, auth:false)` on a fresh stack.
  # This target is built locally only — it is NOT the GHCR image (that's `app`).
  # It never serves traffic and is not published to any port.
  migrate:
    build:
      context: .
      dockerfile: apps/web/Dockerfile
      target: migrate
    container_name: lp-migrate
    restart: "no"
    environment:
      # Same prod DATABASE_URL the app uses: host `postgres`, real password.
      # loadEnvOnce() in migrate.ts sees this set and skips its .env walk, so the
      # unreachable localhost dev default never applies in the container.
      DATABASE_URL: postgres://${POSTGRES_USER:-learning_platform}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-learning_platform}
    depends_on:
      postgres:
        condition: service_healthy

  app:
    # Image: the GHCR artifact produced by `.github/workflows/deploy.yml`
    # (ghcr.io/${{ github.repository }}/web:latest → ghcr.io/yahou110/learning-platform/web:latest).
    # Present so `docker compose pull` (run by the CI/CD SSH deploy step) fetches
    # the remotely-built image instead of re-building on the host. The `build:`
    # block below is for LOCAL use only (Docker Desktop / a fresh checkout without
    # GHCR auth): when `image:` and `build:` both exist, Compose builds if the tag
    # is missing locally and pulls if `pull_policy` requests it. On the VPS, CI
    # pushes the image first, then `deploy.yml` runs `pull`+`up` — so the host
    # never builds. (This fixes the M6 defect where pull had no image to fetch.)
    image: ghcr.io/yahou110/learning-platform/web:latest
    build:
      # Context MUST be repo root (where this compose file lives). A parent
      # repo previously set `context: ..`, which only worked if the compose file
      # sat one level below root — it does NOT, so `..` walked up into the parent
      # dir and the build failed with "GetFileAttributesEx D:\code\apps". Use `.`.
      context: .
      dockerfile: apps/web/Dockerfile
    container_name: lp-app
    restart: unless-stopped
    environment:
      NODE_ENV: production
      DATABASE_URL: postgres://${POSTGRES_USER:-learning_platform}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-learning_platform}
      AUTH_SECRET: ${AUTH_SECRET}
      AUTH_TRUST_HOST: "true"
      NEXTAUTH_URL: ${NEXTAUTH_URL}
      # Object storage (MinIO) — v1 uses local MinIO
      S3_ENDPOINT: http://minio:9000
      S3_ACCESS_KEY: ${MINIO_ROOT_USER:-minioadmin}
      S3_SECRET_KEY: ${MINIO_ROOT_PASSWORD}
      S3_BUCKET: ${S3_BUCKET:-learning-platform}
      S3_REGION: auto
      # Metrics token (optional; if unset, /api/metrics returns 503 in prod)
      METRICS_TOKEN: ${METRICS_TOKEN}
    depends_on:
      postgres:
        condition: service_healthy
      minio:
        condition: service_healthy
      # app boots only AFTER migrations have applied (ADR-0017) — so it never
      # serves against a schema-less DB. service_completed_successfully means
      # the `migrate` one-shot exited 0.
      migrate:
        condition: service_completed_successfully
    ports:
      - "127.0.0.1:3000:3000"
    healthcheck:
      # Use 127.0.0.1 (IPv4 explicit), not `localhost`. On node:20-alpine the
      # busybox `wget` resolves `localhost` to ::1 (IPv6) first; the Next.js
      # standalone server binds 0.0.0.0 (IPv4), so `localhost` probes get
      # "Connection refused" and the container is reported unhealthy even though
      # the app serves 200 on 127.0.0.1 (confirmed during M6 local verification).
      test: ["CMD", "wget", "-q", "--spider", "http://127.0.0.1:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s

volumes:
  lp_pg_data:
    name: lp_pg_data
  lp_minio_data:
    name: lp_minio_data

networks:
  default:
    name: lp-network